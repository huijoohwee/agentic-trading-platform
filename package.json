{
  "name": "agentic-trading-platform",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "doctor": "agentic-os doctor",
    "lane": "agentic-os start",
    "land": "agentic-os land",
    "successor": "agentic-os successor",
    "status": "agentic-os status",
    "reap": "agentic-os reap",
    "finish": "agentic-os finish",
    "release:common": "agentic-os release-common",
    "sync:canonical": "agentic-os canonical-sync",
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --test test/*.test.mjs",
    "check:browser": "node test/browser.mjs",
    "check:runtime-browser": "node test/runtime-browser.mjs",
    "check:runtime": "node --test test/runtime-*.test.mjs test/paper-guard.test.mjs test/forward-runtime.test.mjs test/skill-package.test.mjs",
    "runtime": "node scripts/runtime.mjs",
    "market:import": "python3 scripts/import-pool-history.py",
    "market:snapshot": "node scripts/publish-market-snapshot.mjs",
    "package:skill": "python3 scripts/package-skill.py",
    "package:replay": "python3 scripts/package-replay.py",
    "audit:local": "node scripts/audit.mjs",
    "rehearsal": "node scripts/rehearse.mjs",
    "quote:moomoo": "node scripts/moomoo-quote.mjs"
  },
  "devDependencies": {
    "agentic-os": "https://codeload.github.com/huijoohwee/agentic-os/tar.gz/140d9b1977ba0f304350e2aea7ab543642fc9a27"
  },
  "dependencies": {
    "agentic-gateway": "https://codeload.github.com/huijoohwee/agentic-gateway/tar.gz/deae059ed216b4b66d7374bab78a54e4dbbf012f"
  }
}
